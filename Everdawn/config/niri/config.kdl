// --- Input Settings ---
prefer-no-csd
input {
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
    keyboard {
        xkb {
            layout "gb"
            // options "caps:escape" // Uncomment to map CapsLock to Esc
        }
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        dwt // Disable While Typing
        natural-scroll
    }

    mouse {
         accel-profile "flat"
    }
}

cursor{
    xcursor-theme "Bibata-Modern-Ice"
}

gestures {
    hot-corners{
      off
    }

  
}
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
}

// --- Output (Monitor) Settings ---

output "HDMI-A-2" {
  mode "1920x1080@60"
  scale 1
  position x=2560 y=360
}
output "DP-1" {
    mode "2560x1440@165"
    position x=0 y=0
    variable-refresh-rate on-demand=true
    scale 1

}
// --- Layout & Visuals ---
layout {
    gaps 16 // Space between windows
    center-focused-column "never" // Keep focus movement predictable
    always-center-single-column
    background-color "transparent"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        on
        width 1
    }
    shadow {
        on
        softness 15
        spread 5
        offset x=0 y=8
        draw-behind-window true
        color "#ff000000"
    }

    border {
        off // Turn on if you prefer borders over focus rings
        width 1
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}



// --- Window Rules ---
window-rule {
  geometry-corner-radius 0
  draw-border-with-background false
  clip-to-geometry true
  background-effect {
    blur true
    xray false
    noise 0.05
}

}

blur {
  on
  passes 2
}

window-rule {
  match app-id="spotify"
  default-column-width {fixed 1485;}
  open-on-output "HDMI-A-2"

}

window-rule{
  match app-id="vesktop"
  match app-id="discord"
  match app-id="com.ktechpit.whatsie"
  default-column-width {fixed 1371;}
  open-on-output "HDMI-A-2"
}

window-rule{
  match app-id="steam"
  open-maximized true
  open-on-output "HDMI-A-2"
}

window-rule {
    match title="^Friends List$"
    open-floating true
    default-column-width {fixed 300;}
    default-window-height {fixed 700;}
}

window-rule {
    match title="Obsidian"
    open-floating true
    default-column-width {fixed 600;}
    default-window-height {fixed 500;}
    default-floating-position x=16 y=5 relative-to="top-left"
}

window-rule {
  match app-id="steam_app_*"
  variable-refresh-rate true
  open-on-output "DP-1"
  open-fullscreen true

}

layer-rule {
    place-within-backdrop true
}

hotkey-overlay{
  skip-at-startup
}

overview {
  zoom 0.25
}

// --- Startup Applications ---
spawn-at-startup "noctalia"
spawn-at-startup "xwayland-satellite" // Essential if using X11 apps
spawn-at-startup "swww-daemon" // Wallpaper daemon
spawn-at-startup "spotify"
spawn-at-startup "discord"
spawn-at-startup "steam"
spawn-at-startup "python3" "/home/ozgur/.config/scripts/niri_tile_to_n.py"

// --- Keybindings ---
binds {
    // -- Mod Key --
    // "Mod" usually refers to the Super/Windows key

    // -- Application Launcher & Terminal --
    Mod+Return { spawn "ghostty"; } // CHANGE THIS to your terminal
    Mod+B {spawn "zen-twilight";}
    Mod+Space repeat=false { spawn "fish" "-c" "noctalia msg panel-toggle launcher"; }
    Mod+E {spawn-sh "dolphin";}
    Mod+Shift+E {spawn "ghostty" "-e" "yazi";}
    Ctrl+Shift+Escape {spawn-sh "ghostty -e btop";}
    Mod+Ctrl+W {spawn "fish" "-c" "noctalia msg panel-toggle wallpaper";}
    Mod+I {spawn "fish" "-c" "noctalia msg settings-toggle";}
    Mod+P {spawn "fish" "-c" "zen-twilight --private-window";}
    Mod+Ctrl+Q {spawn "fish" "-c" "noctalia msg panel-toggle session";}

    Alt+Shift+S { spawn-sh "pkill -SIGUSR1 -f gpu-screen-recorder & notify-send 'Clip Saved' "; }

    // -- Window Management --
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V {toggle-overview;}
    // -- Navigation (Vim-style) --
    Mod+A { focus-column-left; }
    Mod+D { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Z { focus-workspace-down; }
    Mod+X { focus-workspace-up; }
    Mod+S { focus-monitor-next;}
    Mod+C {move-window-to-monitor-next;}
    Mod+Shift+D {consume-or-expel-window-right;}
    Mod+Shift+A {consume-or-expel-window-left;}
    Mod+Shift+Right {focus-column-last;}
    Mod+Shift+Left {focus-column-first;}

    
    // -- Navigation (Scroll Wheel)
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }


    // -- Consuming/Expelling (Niri Specific) --
    // Moves the window into the adjacent column or pulls it out
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // -- System --
    Mod+Shift+S { screenshot show-pointer=false; } // Native Niri screenshot

    // -- Volume/Brightness (Requires functional keys) --
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp  { spawn "brightnessctl" "set" "+10%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
    XF86AudioPlay {spawn "fish" "-c" "playerctl play-pause";}
    XF86AudioNext {spawn "fish" "-c" "playerctl next";}
    XF86AudioPrev {spawn "fish" "-c" "playerctl previous";}
    Mod+M { spawn "fish" "-c" "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

}

// --- Animations ---
animations {
    // Niri has smooth procedural animations by default
    // slowing them down makes them feel "weightier"
    slowdown 1.0

     window-open {
      duration-ms 175
      curve "ease-out-quad"
      custom-shader r"
        vec4 zoom_in(vec3 coords_geo, vec3 size_geo) {
          float progress = niri_clamped_progress;
          float scale = progress;
          vec2 coords = (coords_geo.xy - vec2(0.5, 0.5)) * size_geo.xy;
          coords = coords / scale;
          coords_geo = vec3(coords / size_geo.xy + vec2(0.5, 0.5), 1.0);
          vec3 coords_tex = niri_geo_to_tex * coords_geo;
          vec4 color = texture2D(niri_tex, coords_tex.st);
          color.a *= progress;

          return color;
        }
        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
          return zoom_in(coords_geo, size_geo);
        }
      "
    }

    // Original by Lemmy: https://github.com/ItsLemmy
   window-close {
    duration-ms 400
    curve "ease-out-expo"
    custom-shader r"
    vec4 bob_and_slide(vec3 coords_geo, vec3 size_geo) {
        float progress = niri_clamped_progress;
        
        float y_offset = 0.0;
        
        // Bob phase (0.0 to 0.25) - goes up then back to 0
        if (progress < 0.25) {
            float t = progress / 0.25;
            // Parabola: goes up to peak at t=0.5, back down to 0 at t=1.0
            y_offset = -40.0 * (1.0 - 4.0 * (t - 0.5) * (t - 0.5));
        }
        // Slide phase (0.25 to 1.0) - slides down
        else {
            float slide_progress = (progress - 0.25) / 0.75;
            y_offset = -slide_progress * (size_geo.y + 100.0);
        }
        
        // Apply transformation
        vec2 coords = coords_geo.xy * size_geo.xy;
        coords.y = coords.y + y_offset;
        
        coords_geo = vec3(coords / size_geo.xy, 1.0);
        
        vec3 coords_tex = niri_geo_to_tex * coords_geo;
        vec4 color = texture2D(niri_tex, coords_tex.st);
        
        return color;
    }
    vec4 close_color(vec3 coords_geo, vec3 size_geo) {
        return bob_and_slide(coords_geo, size_geo);
    }"
}
    
    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=750 epsilon=0.0001
    }

    window-movement {  
         spring damping-ratio=0.8 stiffness=500 epsilon=0.0001

    }

    workspace-switch {  
         spring damping-ratio=0.8 stiffness=500 epsilon=0.0001

    }

    config-notification-open-close {  
         spring damping-ratio=0.8 stiffness=500 epsilon=0.0001

    }

    screenshot-ui-open {
        duration-ms 1000
        curve "ease-out-expo"
    }

}

debug {
    disable-direct-scanout
}


include "./noctalia.kdl"

