// Inspimagenta by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "kitty",
      "source": "/home/ozgur/Pictures/ffFull/*", 
     "color": {
        "1": "38;2;255;209;220"
        },
      "padding":{
          "top": 2,
          "left": 0,
        },
    },
"display": {
    "separator": ":  ",
  },
 "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[35m\u001B[1m┌───────────────────── Hardware ─────────────────────┐"
        },
        {
            "type": "command",
            "key": "│  System",
            "keyColor": "magenta",
            "text": "echo $USER@$HOSTNAME"
        },
        {
            "type": "cpu",
            "key": "│ ├ CPU",
            "keyColor": "magenta",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "│ ├󰢮 GPU",
            "keyColor": "magenta",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "│ ├󰘚 RAM",
            "keyColor": "magenta"
        },

        {
            "type": "disk",
            "key": "│ ├󰋊 Home",
            "keyColor": "magenta",
            "folders": ["/"]
        },

        {
            "type": "disk",
            "key": "│ ├󰋊 Sata",
            "keyColor": "magenta",
            "folders": ["/mnt/SataSSD"]
        },

        {
            "type": "disk",
            "key": "│ └󰋊 NVME",
            "keyColor": "magenta",
            "folders": ["/mnt/NVME"]
        },
        {
            "type": "custom",
            "format": "\u001b[35m\u001B[1m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[35m\u001B[1m┌───────────────────── Software ─────────────────────┐"
        },
        {
            "type": "os",
            "key": "│  OS",
            "keyColor": "magenta",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "│ ├ Kernel",
            "keyColor": "magenta"
        },

                {
            "type": "shell",
            "key": "│ ├ Shell",
            "keyColor": "magenta"
        },
        {
            "type": "de",
            "key": "│  DE",
            "keyColor": "magenta"
        },

        {
            "type": "wm",
            "key": "│ ├ WM",
            "keyColor": "magenta",
            "format": "{2}"
        },

        {
            "type": "terminal",
            "key": "│ └ Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[35m\u001B[1m└──────────────── Desktop Enviroment ────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[35m\u001B[1m┌───────────────── Age / Uptime ─────────────────────┐"
        },
        {
            "type": "command",
            "key": "│ 󱕅  OS Age ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "│   Uptime ",
            "keyColor": "magenta"
        },
  
        {
            "type": "custom",
            "format": "\u001b[35m\u001B[1m└────────────────────────────────────────────────────┘"
        },

    ]
}
